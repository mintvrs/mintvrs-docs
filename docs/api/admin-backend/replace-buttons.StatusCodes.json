{"responses":{"200":{"description":"Layout salvo (substituição total aplicada).","content":{"application/json":{"schema":{"type":"object","properties":{"interactive_buttons_enabled":{"type":"boolean","description":"Se a etapa de botões interativos está habilitada na campanha"},"button_layout_image":{"type":"string","description":"URL pública da imagem de fundo usada no editor","nullable":true},"buttons":{"description":"Botões posicionados","type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Identificador do botão = nome do ícone escolhido pelo dono (o frontend mapeia para um SVG)","example":"mic"},"x":{"type":"number","description":"Posição X em percentual (0-100)","example":42.5},"y":{"type":"number","description":"Posição Y em percentual (0-100)","example":73.1},"enabled":{"type":"boolean","description":"Botão habilitado (default true)","default":true},"width":{"type":"number","description":"Largura em percentual (0-100)","example":12},"height":{"type":"number","description":"Altura em percentual (0-100)","example":8},"order":{"type":"number","description":"Ordem de renderização","example":0},"type":{"type":"string","description":"Tipo de arquivo que o botão abre. Define quais formatos o upload aceita.","enum":["IMAGE","VIDEO","AUDIO","FILE","PROFILE"],"example":"VIDEO"},"fileUrl":{"type":"string","description":"URL pública do arquivo do botão. Definida pelo endpoint de upload (POST /campaigns/:id/buttons/:buttonId/file); enviar aqui no PUT é opcional e o valor já salvo é preservado.","example":"https://s3.us-east-1.amazonaws.com/public.homolog.mintvrs.com/campaigns/`id`/buttons/video-123.mp4"},"fileName":{"type":"string","description":"Nome original do arquivo enviado no botão","example":"teaser.mp4"},"fields":{"description":"Campos label/valor do botão PROFILE, na ordem de exibição. A ordem do array é a ordem exibida. Omitir preserva o que já está salvo; enviar `[]` limpa.","type":"array","items":{"type":"object","propertie